[Unit]
Description=BetterYAM device daemon
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
ExecStart=/opt/betteryam/bin/betteryamd --data-dir /opt/betteryam/data
Restart=on-failure
RestartSec=2
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
